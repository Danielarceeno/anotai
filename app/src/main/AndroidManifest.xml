<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Auto-granted at install (no user toggle needed) for apps whose core purpose is alarms or
         reminders, which this is. SCHEDULE_EXACT_ALARM stays as a fallback for API 31 and 32,
         where USE_EXACT_ALARM doesn't exist yet and the user must grant "Alarms & reminders" by hand. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".NotepadApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notepad">

        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SearchActivity"
            android:exported="true"
            android:label="@string/search_title"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>
            <!-- Internal action, mirroring the colornote-specific
                 "note.socialnmobile.intent.action.SEARCH" found in the
                 reference APK's manifest: lets other screens in this app
                 jump straight into search without going through the
                 system search intent. -->
            <intent-filter>
                <action android:name="com.example.notepad.action.SEARCH" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <activity
            android:name=".ui.NoteEditorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CalendarActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/calendar_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Points to the Search activity, mirroring ColorNote's
                 android.app.default_searchable wiring so the system
                 Quick Search Box can target this app. -->
            <meta-data
                android:name="android.app.default_searchable"
                android:value=".ui.SearchActivity" />
            <!-- Long-press launcher icon shortcuts: New text note / New checklist. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ui.ReminderActivity"
            android:exported="false"
            android:label="@string/reminder_title" />

        <activity
            android:name=".ui.TrashActivity"
            android:exported="false"
            android:label="@string/trash_title" />

        <activity
            android:name=".ui.FoldersActivity"
            android:exported="false"
            android:label="@string/folders_title" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".ui.DriveSyncActivity"
            android:exported="false"
            android:label="@string/drive_sync_title" />

        <activity
            android:name=".ui.LockActivity"
            android:exported="false" />

        <receiver
            android:name=".notification.DailyReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".notification.NoteReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".notification.SnoozeReceiver"
            android:exported="false" />

        <receiver
            android:name=".notification.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.TodayNotesWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_adaptive">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_notes_info" />
        </receiver>

        <!-- Three fixed-size siblings of the resizable widget above, each its own pickable entry
             in the launcher's widget picker instead of only reachable by resizing that one down:
             a 1x1 date tile, a 2x2 small list, and a visually different 2x2 "at a glance" summary
             (TodayNotes1x1WidgetProvider / TodayNotes2x2WidgetProvider /
             TodayNotesSummaryWidgetProvider). -->
        <receiver
            android:name=".widget.TodayNotes1x1WidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_1x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_1x1_info" />
        </receiver>

        <receiver
            android:name=".widget.TodayNotes2x2WidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_2x2_list">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_2x2_info" />
        </receiver>

        <receiver
            android:name=".widget.TodayNotesSummaryWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_2x2_summary">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_summary_2x2_info" />
        </receiver>

        <service
            android:name=".widget.TodayNotesRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Hands a "share as image" render of a note to whatever app the user picks, without
             granting that app's whole package access to this app's files. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
