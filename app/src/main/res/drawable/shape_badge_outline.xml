<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded-pill outline for the due-date badge in the note editor, matching the
     reference screenshot in imagens/ (a bordered rectangle around the date, with
     a small dot indicating a reminder is active). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="8dp" />
    <stroke android:width="1dp" android:color="?attr/colorOutline" />
    <solid android:color="@android:color/transparent" />
</shape>
