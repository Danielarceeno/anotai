<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Note color palette, matching the 3x3 color picker grid from the
         reference ColorNote screenshots (red/orange/yellow/green/blue/purple,
         then black/gray/white). Index 6 (black/dark) is the default for new
         notes (see NoteEditorActivity.DEFAULT_COLOR_INDEX). Shared by light
         and dark mode. -->
    <color name="note_color_0">#E7473C</color>
    <color name="note_color_1">#F2A33E</color>
    <color name="note_color_2">#FBE63B</color>
    <color name="note_color_3">#5BAF4A</color>
    <color name="note_color_4">#2F72C5</color>
    <color name="note_color_5">#B4409A</color>
    <color name="note_color_6">#1A1A1A</color>
    <color name="note_color_7">#9E9E9E</color>

    <!-- Sampled from the corner of imagens/logo.png, used as the adaptive launcher icon's background layer. -->
    <color name="launcher_icon_background">#0C0C0D</color>

    <!-- App theme palette, light mode: ColorNote's teal accent on a plain light surface. -->
    <color name="accent_teal">#4FB8AA</color>
    <color name="on_accent_teal">#06201C</color>
    <color name="app_background">#FFFFFF</color>
    <color name="app_surface">#FFFFFF</color>
    <color name="on_surface">#1A1A1A</color>
    <color name="on_surface_variant">#5F6368</color>
    <color name="toolbar_background">#F5F5F5</color>
    <color name="dialog_background">#FFFFFF</color>

    <!-- Note editor body: only the toolbar/header is tinted to the note's color now, the rest
         of the editor (text fields, checklist) stays fixed black with light text in both themes. -->
    <color name="note_editor_body_background">#000000</color>
    <color name="note_editor_body_text">#F5F5F5</color>
    <color name="note_editor_body_hint">#80F5F5F5</color>
    <!-- Checklist row separator: a flat gray, not alpha-blended, since the body background is
         always black (see above); a faint alpha-over-black divider was invisible in practice. -->
    <color name="checklist_item_divider">#4D4D4D</color>

    <!-- Daily reminder notification's small-icon tint (NotificationCompat.Builder.setColor): the
         status bar itself always renders the icon as a flat silhouette regardless of this, but
         it colors the icon's background circle in the notification shade on most launchers. -->
    <color name="notification_icon_color">#9E9E9E</color>

    <!-- Calendar reminder dot, same hue in both themes (matches the reference screenshots). -->
    <color name="calendar_dot">#F2D43B</color>
    <!-- Thin grid lines between day cells, subtle enough not to compete with the dots/numbers. -->
    <color name="calendar_grid_line">#1F000000</color>
    <!-- Faint day-number color for weekends (Saturday red, Sunday blue): soft/pale shades so
         the number stays easy to read rather than shouting over the grid. -->
    <color name="calendar_saturday_number">#E57373</color>
    <color name="calendar_sunday_number">#64B5F6</color>

    <!-- Home-screen "Today" widget: always dark, independent of system light/dark mode. -->
    <color name="widget_background">#1E1E1E</color>
    <color name="widget_on_background">#F5F5F5</color>
    <color name="widget_on_background_variant">#9E9E9E</color>
    <color name="widget_divider">#33FFFFFF</color>
</resources>
