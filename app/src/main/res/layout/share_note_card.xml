<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated off-screen by ShareImageHelper and drawn straight to a Bitmap, never actually
     attached to a window, so this intentionally avoids ?attr/ theme references (there's no
     Activity theme context guaranteed at render time) in favor of explicit colors set in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shareCardRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/shareTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/shareBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="4dp"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/shareWatermark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:alpha="0.65"
        android:text="@string/app_name"
        android:textSize="12sp" />

</LinearLayout>
