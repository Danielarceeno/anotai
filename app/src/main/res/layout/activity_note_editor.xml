<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/note_editor_body_background"
    android:orientation="vertical">

    <!-- Reference design: checkmark / title textbox / color swatch / overflow,
         all inside the colored toolbar strip (title is edited in place here,
         not as a separate field in the body). -->
    <LinearLayout
        android:id="@+id/toolbarRoot"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/doneButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/save_and_close"
            android:src="@drawable/ic_check" />

        <EditText
            android:id="@+id/titleInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/shape_title_input_bg"
            android:gravity="center_vertical"
            android:hint="@string/title_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="#1A1A1A"
            android:textColorHint="#801A1A1A" />

        <FrameLayout
            android:id="@+id/colorToggleContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/shape_selection_ring">

            <ImageView
                android:id="@+id/colorToggleButton"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/shape_color_swatch"
                android:contentDescription="@string/note_color" />

        </FrameLayout>

        <ImageButton
            android:id="@+id/overflowButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_options"
            android:src="@android:drawable/ic_menu_more"
            android:visibility="gone" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/colorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone" />

    </HorizontalScrollView>

    <!-- Text notes grow like a sheet of paper: bodyInput is wrap_content with a minHeight (not a
         weighted fill), and this whole column scrolls as one page once the typed text plus the
         rows above it exceed the screen, instead of only the EditText scrolling internally. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bodyScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp">

                <TextView
                    android:id="@+id/editingLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/editing_label"
                    android:textColor="@color/note_editor_body_text"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/reminderRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_badge_outline"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="@string/set_reminder"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

            <TextView
                android:id="@+id/folderRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="@string/folder_none"
                android:textColor="?attr/colorPrimary"
                app:drawableStartCompat="@android:drawable/ic_menu_sort_by_size"
                app:drawableTint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/imageRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="@string/add_photo"
                android:textColor="?attr/colorPrimary"
                app:drawableStartCompat="@android:drawable/ic_menu_camera"
                app:drawableTint="?attr/colorPrimary" />

            <FrameLayout
                android:id="@+id/imagePreviewContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imagePreview"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:contentDescription="@string/add_photo"
                    android:scaleType="centerCrop" />

                <ImageButton
                    android:id="@+id/removeImageButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="top|end"
                    android:background="@android:color/black"
                    android:contentDescription="@string/action_remove"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/formatToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/boldButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/format_bold"
                    android:gravity="center"
                    android:text="@string/format_bold_label"
                    android:textColor="@color/note_editor_body_text"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/italicButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/format_italic"
                    android:gravity="center"
                    android:text="@string/format_italic_label"
                    android:textColor="@color/note_editor_body_text"
                    android:textStyle="italic"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/underlineButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/format_underline"
                    android:gravity="center"
                    android:text="@string/format_underline_label"
                    android:textColor="@color/note_editor_body_text"
                    android:textSize="16sp" />

            </LinearLayout>

            <EditText
                android:id="@+id/bodyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="280dp"
                android:background="@android:color/transparent"
                android:gravity="top"
                android:hint="@string/body_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp"
                android:textColor="@color/note_editor_body_text"
                android:textColorHint="@color/note_editor_body_hint"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/checklistContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/checklistRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="32dp"
            android:background="@color/checklist_item_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp">

            <ImageView
                android:id="@+id/newItemIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@android:drawable/ic_input_add"
                app:tint="@color/note_editor_body_hint" />

            <EditText
                android:id="@+id/newItemInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/add_item_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:padding="16dp"
                android:textColor="@color/note_editor_body_text"
                android:textColorHint="@color/note_editor_body_hint"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
