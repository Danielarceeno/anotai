<?xml version="1.0" encoding="utf-8"?>
<!-- One specific, user-chosen note (see PickedNoteWidgetConfigActivity) pinned to the home
     screen, tinted to that note's own resolved color. Password-protected notes show the same
     locked-preview text and lock icon used everywhere else in the app (list, search, calendar,
     "today" widget), never the real body. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetPickedRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:id="@+id/widgetPickedLock"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/note_locked"
            android:src="@android:drawable/ic_lock_lock"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widgetPickedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/widget_on_background"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
