# Copy this to keystore.properties (gitignored) and fill in real values, or generate your own
# keystore with:
#   keytool -genkeypair -v -keystore app/anotai-release.jks -alias anotai \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Without a keystore.properties file present, `./gradlew assembleRelease` still produces a
# minified, unsigned release APK -- it just can't be installed until it's signed.
storeFile=app/anotai-release.jks
storePassword=changeme
keyAlias=anotai
keyPassword=changeme
