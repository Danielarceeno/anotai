# Gradle
.gradle/
build/
*/build/
.kotlin/

# Local machine config (SDK path, never shared between machines)
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Signing keys -- never commit these
*.jks
*.keystore
keystore.properties

# Built app packages (install from CI/Releases instead of committing binaries)
*.apk
*.aab

# Stray Android SDK command-line tools copy living inside this folder -- installed per
# developer via Android Studio's SDK Manager, not part of the project source.
cmdline-tools/

# OS cruft
.DS_Store
Thumbs.db

# Claude Code session-local files
.claude/
